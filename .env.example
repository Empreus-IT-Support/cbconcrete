# --- Contact form -> email via Atlas (Empreus's own email platform) ---
# Per-client key minted under Clients > CB Concrete > Documentation > API > Atlas
ATLAS_API_KEY=
# Must be a bare address the Atlas key authorises (no display name) -
# defaults to DoNotReply@cbconcrete.com.au
CONTACT_FROM=DoNotReply@cbconcrete.com.au
# Must be on the key's recipient allowlist - defaults to admin@cbconcrete.com.au
CONTACT_RECIPIENT=admin@cbconcrete.com.au

# --- Pre-launch indexing gate (see app/robots.ts) ---
# Set to "true" in Vercel at launch, not before.
SITE_INDEXABLE=
