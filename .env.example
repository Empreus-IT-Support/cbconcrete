# --- Contact form → email via Resend (https://resend.com) ---
# API key from the Resend dashboard
RESEND_API_KEY=
# Verified sender — the domain must be verified in Resend via DNS records
CONTACT_FROM=CB Concrete Website <website@cbconcrete.com.au>
# Where enquiries are delivered (defaults to admin@cbconcrete.com.au)
CONTACT_RECIPIENT=admin@cbconcrete.com.au
